# Einstellungen für den Bibliothekshackathon
# Diese Datei als ".env" kopieren und die Werte von der Orga eintragen.

# Welches Modell die Beispiel-Flows standardmäßig nutzen: "cluster" oder "lokal"
KI_STANDARD=cluster

# --- Cluster (LiteLLM) --------------------------------------------------------
# Adresse und Gruppen-Schlüssel bekommt ihr von der Orga.
CLUSTER_BASE_URL=https://litellm.example.org/v1
CLUSTER_API_KEY=sk-bitte-eintragen
CLUSTER_MODELL=

# --- Lokal (Ollama) -----------------------------------------------------------
# Ollama direkt auf dem Laptop installiert (empfohlen auf dem Mac):
LOKAL_BASE_URL=http://host.docker.internal:11434/v1
# Ollama per "docker compose --profile lokal up -d" gestartet:
# LOKAL_BASE_URL=http://ollama:11434/v1
LOKAL_MODELL=qwen3.5:4b
# Wie viel Text das lokale Modell auf einmal lesen kann (Tokens). Mehr braucht mehr Arbeitsspeicher.
LOKAL_KONTEXT=16384

# --- Literaturdatenbanken -----------------------------------------------------
# E-Mail-Adresse für Crossref, OpenAlex und Unpaywall (höfliche Nutzung, schnellere Antworten).
# Unpaywall findet damit zusätzliche freie Volltexte.
KONTAKT_EMAIL=
# Kostenloser Schlüssel von https://openalex.org/settings/api – ohne Schlüssel wird die
# Suche bei vielen Anfragen gebremst (alle Gruppen im selben WLAN teilen sich das Limit).
OPENALEX_API_KEY=
